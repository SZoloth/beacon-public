#!/bin/zsh
# Build Beacon for the iPhone and install it on a paired phone, with this Mac's Tailscale address
# built in as the phone's default server. The address never enters the repo (public builds keep a
# placeholder); Settings › Beacon on the phone still overrides it.
#
#   scripts/install-phone [DEVICE-ID]   default: the first paired physical iPhone
set -euo pipefail
cd "${0:A:h}/../app/one"

name=$(tailscale status --json | /usr/bin/python3 -c 'import json, sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))')
[[ -n $name ]] || { echo "install-phone: Tailscale has no name for this Mac. Is it signed in?" >&2; exit 1; }
server="http://$name:8765"

device=${1:-$(xcrun devicectl list devices 2>/dev/null | awk '/physical/ && /iPhone/ && /available|connected/ {for (i = 1; i <= NF; i++) if ($i ~ /^[0-9A-F]{8}-[0-9A-F]{16}$/) {print $i; exit}}')}
[[ -n $device ]] || { echo "install-phone: no paired iPhone is available. Unlock it and connect it." >&2; exit 1; }

xcodegen generate --quiet
xcodebuild -project Beacon.xcodeproj -scheme BeaconPhone2 -configuration Release -destination "id=$device" \
  -derivedDataPath build/dd-phone -allowProvisioningUpdates BEACON_DEFAULT_SERVER="$server" build -quiet
app=build/dd-phone/Build/Products/Release-iphoneos/BeaconPhone2.app
built=$(/usr/libexec/PlistBuddy -c "Print :BeaconDefaultServer" "$app/Info.plist")
[[ $built == "$server" ]] || { echo "install-phone: the build has '$built', expected '$server'" >&2; exit 1; }
xcrun devicectl device install app --device "$device" "$app" >/dev/null
xcrun devicectl device process launch --device "$device" com.example.beacon-one >/dev/null
rm -rf build/dd-phone
echo "Installed Beacon on $device; it reaches $server"
